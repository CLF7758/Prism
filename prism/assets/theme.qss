/*
 * Prism — 由 prism/ui_tokens.py 生成，请不要直接编辑这个文件。
 *
 * 改颜色  → prism/ui_tokens.py
 * 改结构  → tools/theme_template.qss
 * 然后跑 → .\\.venv\\Scripts\\python tools\\build_theme.py
 *
 * 依据：桌面/Prism-全套UI与交互开发规范-v1.md §4 / §5 / §6
 * 模式：dark
 */
/* ── Global ─────────────────────────────────────────────── */
* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #E7E9ED;
}

/* Shared panel roles use the same token source as the Qt shell. */
QWidget#prismSidebar, QWidget#prismInspector {
    background-color: #222327;
}
QDialog#tagManagerDialog {
    background-color: #222327;
}
QLabel[uiRole="secondary"] {
    color: #AAB0BB;
    font-size: 12px;
}
QLabel[uiRole="secondarySmall"] {
    color: #AAB0BB;
    font-size: 11px;
}
QLabel[uiRole="treeSection"] {
    color: #AAB0BB;
    font-size: 12px;
    font-weight: 600;
}
QLabel[uiRole="inspectorTitle"] {
    color: #E7E9ED;
    font-size: 14px;
    font-weight: 600;
}
QLabel[uiRole="inspectorSection"] {
    color: #AAB0BB;
    font-size: 12px;
    font-weight: 600;
}
QLabel[uiRole="inspectorValue"] {
    color: #E7E9ED;
    font-size: 13px;
}
QLabel#inspectorPreview {
    background-color: #191A1D;
    border-radius: 6px;
}
QWidget#inspectorHistogram {
    background-color: #191A1D;
    border-radius: 4px;
}
QLabel#inboxPreview {
    background-color: #191A1D;
    color: #AAB0BB;
}
QWidget#colorFilterBar {
    background-color: #25262B;
}
QFrame#filterSeparator {
    color: #363940;
}

/* ── Main Window ────────────────────────────────────────── */
QMainWindow {
    background-color: #191A1D;
}

/* ── Scroll Areas ───────────────────────────────────────── */
/*
 * The colour strip sits inside a QScrollArea at the top of the window
 * (see PrismMainWindow).  Qt's default palette for scroll areas is light,
 * so without this rule that strip renders as a pale band wedged between
 * the dark menu bar and the dark panels -- which is where the window
 * looked least like one thing.  Everything here is transparent so the
 * window base shows through and the strip's own background (set on
 * ColorFilterBar) is what you see.
 */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* ── Menu Bar ───────────────────────────────────────────── */
QMenuBar {
    background-color: #191A1D;
    border: none;
    border-bottom: 1px solid #30333A;
    padding: 2px 0px;
    spacing: 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 5px;
    color: #E7E9ED;
    font-size: 13px;
}

QMenuBar::item:selected {
    background-color: #79AEFF;
    color: #FFFFFF;
}

QMenuBar::item:pressed {
    background-color: #79AEFF;
}

/* ── Menus ──────────────────────────────────────────────── */
QMenu {
    background-color: #2A2C32;
    border: 1px solid #363940;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 5px 28px 5px 16px;
    border-radius: 5px;
    background: transparent;
    color: #E7E9ED;
    font-size: 13px;
}

QMenu::item:selected {
    background-color: #79AEFF;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #727883;
}

QMenu::separator {
    height: 1px;
    background: #30333A;
    margin: 3px 10px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 4px;
}

/* ── Buttons ────────────────────────────────────────────── */
QPushButton {
    background-color: #2C2E34;
    border: 1px solid #363940;
    border-radius: 6px;
    padding: 4px 12px;
    min-height: 22px;
    min-width: 64px;
    color: #E7E9ED;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #30333A;
    border-color: #383C45;
}

QPushButton:pressed {
    background-color: #383C45;
}

QPushButton:disabled {
    background-color: #2C2E34;
    color: #727883;
    border-color: #363940;
}

QPushButton:checked {
    background-color: #263E5A;
    border-color: #79AEFF;
    color: #E7E9ED;
}

QPushButton:focus {
    border: 2px solid #79AEFF;
}

QPushButton:flat {
    background-color: transparent;
    border: none;
}

QPushButton:flat:hover {
    background-color: #30333A;
    border-radius: 5px;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
    padding: 6px 18px;
}

QDialogButtonBox QPushButton[text="OK"],
QDialogButtonBox QPushButton[text="Save"],
QDialogButtonBox QPushButton[text="Apply"] {
    background-color: #79AEFF;
    border-color: #79AEFF;
    color: #FFFFFF;
}

QDialogButtonBox QPushButton[text="OK"]:hover,
QDialogButtonBox QPushButton[text="Save"]:hover,
QDialogButtonBox QPushButton[text="Apply"]:hover {
    background-color: #79AEFF;
}

/* ── Inputs ─────────────────────────────────────────────── */
QLineEdit, QPlainTextEdit, QTextEdit {
    background-color: #2C2E34;
    border: 1px solid #363940;
    border-radius: 6px;
    padding: 5px 10px;
    color: #E7E9ED;
    selection-background-color: #79AEFF;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 2px solid #79AEFF;
    padding: 4px 9px;
}

QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {
    background-color: #2C2E34;
    color: #727883;
}

/* ── Spin Box ───────────────────────────────────────────── */
QSpinBox, QDoubleSpinBox {
    background-color: #191A1D;
    border: 1px solid #30333A;
    border-radius: 6px;
    padding: 4px 6px;
    color: #E7E9ED;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #79AEFF;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 18px;
    subcontrol-origin: border;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-position: top right;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #30333A;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(assets/icons/chevron-up.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(assets/icons/chevron-down.svg);
    width: 10px;
    height: 10px;
}

/* ── Checkbox ───────────────────────────────────────────── */
QCheckBox {
    spacing: 8px;
    color: #E7E9ED;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #565D69;
    border-radius: 4px;
    background-color: #191A1D;
}

QCheckBox::indicator:hover {
    border-color: #79AEFF;
}

QCheckBox::indicator:checked {
    background-color: #79AEFF;
    border-color: #79AEFF;
    image: url(assets/icons/check.svg);
}

QCheckBox::indicator:disabled {
    background-color: #191A1D;
    border-color: #30333A;
}

/* ── Radio Button ───────────────────────────────────────── */
QRadioButton {
    spacing: 8px;
    color: #E7E9ED;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #565D69;
    border-radius: 9px;
    background-color: #191A1D;
}

QRadioButton::indicator:hover {
    border-color: #79AEFF;
}

QRadioButton::indicator:checked {
    background-color: #79AEFF;
    border-color: #79AEFF;
    image: url(assets/icons/radio-dot.svg);
}

/* ── Combo Box ──────────────────────────────────────────── */
QComboBox {
    background-color: #2C2E34;
    border: 1px solid #30333A;
    border-radius: 6px;
    padding: 4px 10px;
    min-height: 22px;
    color: #E7E9ED;
}

QComboBox:hover {
    background-color: #30333A;
    border-color: #383C45;
}

QComboBox:focus {
    border: 2px solid #79AEFF;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
}

QComboBox::down-arrow {
    image: url(assets/icons/chevron-down.svg);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #2A2C32;
    border: 1px solid #383C45;
    border-radius: 8px;
    padding: 3px;
    selection-background-color: #79AEFF;
    selection-color: #FFFFFF;
}

QComboBox QAbstractItemView::item {
    padding: 4px 14px;
    border-radius: 4px;
    min-height: 22px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #30333A;
}

/* ── Slider ─────────────────────────────────────────────── */
QSlider::groove:horizontal {
    height: 3px;
    background: #383C45;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -7px 0;
    background-color: #E7E9ED;
    border-radius: 8px;
    border: none;
}

QSlider::handle:horizontal:hover {
    background-color: #FFFFFF;
    border: 2px solid #79AEFF;
}

QSlider::handle:horizontal:pressed {
    background-color: #FFFFFF;
    border: 3px solid #79AEFF;
}

QSlider::sub-page:horizontal {
    background: #79AEFF;
    border-radius: 2px;
}

QSlider::groove:vertical {
    width: 3px;
    background: #383C45;
    border-radius: 2px;
}

QSlider::handle:vertical {
    width: 16px;
    height: 16px;
    margin: 0 -7px;
    background-color: #E7E9ED;
    border-radius: 8px;
    border: none;
}

QSlider::handle:vertical:hover {
    background-color: #FFFFFF;
    border: 2px solid #79AEFF;
}

/* ── Scroll Bars ────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 1px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #363940;
    border-radius: 3px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #565D69;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 1px 2px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #363940;
    border-radius: 3px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #565D69;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ── Tabs ───────────────────────────────────────────────── */
QTabWidget::pane {
    background-color: #191A1D;
    border: 1px solid #30333A;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    padding: 6px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    color: #727883;
    font-size: 13px;
}

QTabBar::tab:hover {
    color: #E7E9ED;
}

QTabBar::tab:selected {
    color: #E7E9ED;
    border-bottom: 2px solid #79AEFF;
}

/* ── Group Box ──────────────────────────────────────────── */
QGroupBox {
    background-color: #2A2C32;
    border: 1px solid #30333A;
    border-radius: 8px;
    margin-top: 10px;
    padding: 14px 10px 10px 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 5px;
    color: #AAB0BB;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ── Table View ─────────────────────────────────────────── */
QTableView {
    background-color: #191A1D;
    alternate-background-color: #2A2C32;
    border: 1px solid #30333A;
    border-radius: 6px;
    gridline-color: #363940;
    selection-background-color: #79AEFF;
    selection-color: #FFFFFF;
}

QTableView::item {
    padding: 4px 6px;
}

QTableView::item:hover {
    background-color: #363940;
}

QTableView::item:selected {
    background-color: #79AEFF;
}

QHeaderView::section {
    background-color: #2A2C32;
    border: none;
    border-right: 1px solid #30333A;
    border-bottom: 1px solid #30333A;
    padding: 5px 6px;
    color: #AAB0BB;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

/* ── Tree Widget ────────────────────────────────────────── */
QTreeWidget {
    background-color: #191A1D;
    border: 1px solid #30333A;
    border-radius: 6px;
    alternate-background-color: #2A2C32;
}

QTreeWidget::item {
    padding: 4px 5px;
    border-radius: 4px;
}

QTreeWidget::item:hover {
    background-color: #363940;
}

QTreeWidget::item:selected {
    background-color: #79AEFF;
}

QTreeWidget::branch {
    background: transparent;
}

QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    image: url(assets/icons/chevron-right.svg);
}

QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    image: url(assets/icons/chevron-down.svg);
}

/* ── List Widget / List View ────────────────────────────── */
QListWidget, QListView {
    background-color: transparent;
    border: none;
    outline: none;
}

QListWidget::item, QListView::item {
    padding: 5px 8px;
    border-radius: 5px;
    margin: 1px 0;
}

QListWidget::item:hover, QListView::item:hover {
    background-color: #30333A;
}

QListWidget::item:selected, QListView::item:selected {
    background-color: #263E5A;
    color: #E7E9ED;
}

QTreeView#resourceTree {
    background-color: #222327;
    color: #E7E9ED;
    border: none;
    outline: none;
    font-size: 13px;
}

QTreeView#resourceTree::item {
    min-height: 30px;
    padding: 2px 6px;
    border-radius: 5px;
}

QTreeView#resourceTree::item:hover {
    background-color: #30333A;
}

QTreeView#resourceTree::item:selected {
    background-color: #263E5A;
    color: #E7E9ED;
}

QTreeView#resourceTree::branch:closed:has-children {
    image: url(assets/icons/chevron-right.svg);
}

QTreeView#resourceTree::branch:open:has-children {
    image: url(assets/icons/chevron-down.svg);
}

/* ── Dialogs ────────────────────────────────────────────── */
QDialog {
    background-color: #222327;
}

/* ── Tooltips ───────────────────────────────────────────── */
QToolTip {
    background-color: #2A2C32;
    border: 1px solid #383C45;
    border-radius: 5px;
    padding: 4px 8px;
    color: #E7E9ED;
    font-size: 12px;
}

/* ── Splitter ───────────────────────────────────────────── */
QSplitter::handle {
    background-color: #363940;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #79AEFF;
}

/* ── Progress Bar ───────────────────────────────────────── */
QProgressBar {
    background-color: #30333A;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #79AEFF;
    border-radius: 3px;
}

/* ── Label ──────────────────────────────────────────────── */
QLabel {
    color: #E7E9ED;
    background: transparent;
    border: none;
}

/* ── Key Sequence Edit ──────────────────────────────────── */
QKeySequenceEdit {
    background-color: #191A1D;
    border: 1px solid #30333A;
    border-radius: 5px;
    padding: 3px 6px;
}

QKeySequenceEdit:focus {
    border: 2px solid #79AEFF;
}

/* ── Frame ──────────────────────────────────────────────── */
QFrame {
    border: none;
}

/* ── Status Bar ─────────────────────────────────────────── */
QStatusBar {
    background-color: #191A1D;
    border-top: 1px solid #30333A;
    color: #727883;
    font-size: 12px;
    padding: 2px 6px;
}

QStatusBar::item {
    border: none;
}

/* ── Notification ───────────────────────────────────────── */
QWidget#BeeNotification {
    background-color: #2A2C32;
    border: 1px solid #383C45;
    border-radius: 8px;
    padding: 8px 14px;
}
QWidget#PrismNotification {
    background-color: #2A2C32;
    border: 1px solid #363940;
    border-radius: 8px;
}
QWidget#PrismNotification QLabel {
    color: #E7E9ED;
    font-size: 13px;
}
QWidget#videoControlBar {
    background-color: #2A2C32;
    border-radius: 6px;
}
QWidget#videoControlBar QToolButton {
    border: none;
    background: transparent;
}
QWidget#videoControlBar QLabel {
    color: #E7E9ED;
    font-size: 10px;
}
QWidget#videoControlBar QSlider::groove:horizontal {
    height: 4px;
    background: #565D69;
    border-radius: 2px;
}
QWidget#videoControlBar QSlider::handle:horizontal {
    width: 12px;
    margin: -4px 0;
    background: #E7E9ED;
    border-radius: 6px;
}

/* ── Empty canvas ───────────────────────────────────────── */
/*
 * The overlay shown while the scene is empty.  Like the scroll areas, it
 * would otherwise fill with the platform palette's light background and
 * turn the canvas into a pale rectangle the moment the last image is
 * removed.
 */
QWidget#BeeWelcomeOverlay {
    background-color: #191A1D;
}

QToolBar { spacing: 6px; padding: 6px; border: none; background: #222327; }
QToolButton { padding: 7px 10px; border-radius: 5px; }
QToolButton:hover, QToolButton:checked { background: #263E5A; }
QToolButton#prismIconButton { padding: 0; border: none; }
QToolButton[uiRole="rating"] { padding: 0; border: none; }
QToolButton[uiRole="rating"]:hover { background: #30333A; }
QStatusBar { background: #25262B; padding: 0 8px; }
QFrame#inspectorHeader { background: #222327; border-bottom: 1px solid #363940; }
QFrame#inspectorHeader QLabel { background: transparent; }
QWidget#inspectorBody { background: #222327; }
QFrame#inspectorHeader QLabel[uiRole="sectionTitle"] { font-size: 14px; font-weight: 600; }
QWidget#prismInspector QLabel#inspectorPreview { border-radius: 6px; background: #191A1D; }
QToolButton#shellEdgeHandle { background: #2A2C32; color: #AAB0BB; border: 1px solid #565D69; padding: 0; border-radius: 5px; }
QToolButton#shellEdgeHandle:hover { background: #383C45; color: #E7E9ED; }
